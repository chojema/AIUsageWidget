<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AIUsageWidget.Views.PanelWindow"
        Title="AIUsageWidget"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        CanResize="False"
        Focusable="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="640" Height="52">
  <Window.Styles>
    <Style Selector="Button.panel">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A8AEB8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.prompt">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
  </Window.Styles>
  <Border x:Name="Frame" Background="#F2181A1F" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="12,4,6,4">
    <Panel>
      <!-- Columns are created from the section order in PanelWindow.ApplyLayout. -->
      <Grid x:Name="Cells">
        <StackPanel x:Name="Buttons" VerticalAlignment="Center" Spacing="2">
          <Button x:Name="CloseButton" Classes="panel" Content="✕" />
          <Button x:Name="RefreshButton" Classes="panel" Content="↻" FontSize="13" />
        </StackPanel>
      </Grid>
      <Border x:Name="ClosePrompt" IsVisible="False" Background="#FF181A1F">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
          <TextBlock x:Name="ClosePromptText" VerticalAlignment="Center" FontSize="12" Foreground="#E6E8EC" Margin="0,0,4,0" />
          <Button x:Name="HideButton" Classes="prompt" />
          <Button x:Name="QuitButton" Classes="prompt" />
          <Button x:Name="CancelButton" Classes="prompt" />
        </StackPanel>
      </Border>
    </Panel>
  </Border>
</Window>
