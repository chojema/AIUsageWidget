<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AIUsageWidget.Views.PanelWindow"
        Title="AIUsageWidget"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        CanResize="False"
        Focusable="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="640" Height="52">
  <Border x:Name="Frame" Background="#F2181A1F" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="12,4,8,4">
    <Grid x:Name="Cells" ColumnDefinitions="*,16,*,16,*,12,Auto" />
  </Border>
</Window>
