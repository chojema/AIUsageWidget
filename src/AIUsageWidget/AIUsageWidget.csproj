<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>

    <AssemblyName>AIUsageWidget</AssemblyName>
    <RootNamespace>AIUsageWidget</RootNamespace>
    <Version>0.0.3</Version>
    <Product>AIUsageWidget</Product>
    <Company>AIUsageWidget contributors</Company>
    <Copyright>Copyright (c) 2026 Chojema</Copyright>
    <Description>Shows AI coding agent usage limits below the frontmost terminal window.</Description>

    <!-- Reproducible output without local build paths. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src/AIUsageWidget</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIUsageWidget.Tests" />
  </ItemGroup>

</Project>
